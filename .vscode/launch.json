{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo 18",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/odoo-18.0/odoo-bin",
      "args": [
        "-c",
        "${workspaceFolder}/conf/odoo.conf",
        "--dev=reload"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    }
  ]
}